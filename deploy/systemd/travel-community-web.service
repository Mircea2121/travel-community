[Unit]
Description=Comunitatea Calatorilor Next.js
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=travelcommunity
Group=travelcommunity
WorkingDirectory=/var/www/travel-community/current
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
EnvironmentFile=/var/www/travel-community/shared/.env.production
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/www/travel-community/current/.next

[Install]
WantedBy=multi-user.target
