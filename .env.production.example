# Application
NODE_ENV=production
APP_URL=https://comunitatea-calatorilor.ro
JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_RATE_LIMIT_SECRET=replace-with-a-different-random-secret

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/travel-community?appName=travel-community

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
DEFAULT_AVATAR_URL=https://res.cloudinary.com/replace-me/image/upload/default-avatar.webp
DEFAULT_COVER_URL=https://res.cloudinary.com/replace-me/image/upload/default-cover.webp

# Resend
RESEND_API_KEY=re_replace-me
EMAIL_FROM=Comunitatea Calatorilor <noreply@comunitatea-calatorilor.ro>
SUPPORT_EMAIL=support@comunitatea-calatorilor.ro

# Cloudflare Turnstile - use real production keys, never test keys
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-me
TURNSTILE_SECRET_KEY=replace-me
TURNSTILE_EXPECTED_HOSTNAME=comunitatea-calatorilor.ro

# Realtime and Redis (local to the VPS)
NEXT_PUBLIC_REALTIME_ENABLED=true
NEXT_PUBLIC_REALTIME_URL=https://comunitatea-calatorilor.ro
REDIS_URL=redis://127.0.0.1:6379
REALTIME_ALLOWED_ORIGINS=https://comunitatea-calatorilor.ro,https://www.comunitatea-calatorilor.ro
REALTIME_HOST=127.0.0.1
REALTIME_PORT=3001

# Smoke test
SMOKE_BASE_URL=https://comunitatea-calatorilor.ro
