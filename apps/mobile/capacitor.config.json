{
  "appId": "ro.comunitateacalatorilor.app",
  "appName": "Comunitatea Călătorilor",
  "webDir": "dist",
  "backgroundColor": "#f5f9ff",
  "loggingBehavior": "debug",
  "server": {
    "androidScheme": "https",
    "errorPath": "offline.html"
  },
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "CapacitorCookies": {
      "enabled": true
    },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK"
    }
  }
}
